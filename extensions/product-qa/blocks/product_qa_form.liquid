{% comment %}
  Product Q&A Form Block
  Shared form and modal for customer questions
{% endcomment %}

<div class="product-qa-wrapper" data-product-id="{{ product.id }}">
  <!-- Always Visible Form -->
  <div class="product-qa-form">
    <h3>{{ block.settings.title }}</h3>

    <form id="qa-form" class="qa-form">
      <div class="form-group">
        <label for="customer-name">{{ block.settings.name_label | default: 'Your Name' }}</label>
        <input type="text" id="customer-name" name="customerName" value="{{ customer.name }}" {% if block.settings.name_required %}required{% endif %}>
      </div>

      <div class="form-group">
        <label for="customer-email">{{ block.settings.email_label | default: 'Your Email' }}</label>
        <input type="email" id="customer-email" name="customerEmail" value="{{ customer.email }}" {% if block.settings.email_required %}required{% endif %}>
      </div>

      <div class="form-group">
        <label for="question">{{ block.settings.question_label | default: 'Your Question' }}</label>
        <textarea id="question" name="question" rows="4" required></textarea>
      </div>

      <input type="hidden" name="shop" value="{{ shop.domain }}">
      <input type="hidden" name="productId" value="{{ product.id }}">

      <button type="submit" class="btn btn-primary">{{ block.settings.submit_text | default: 'Submit Question' }}</button>
    </form>

    <div id="form-message" class="form-message" style="display: none;"></div>
  </div>
</div>

<!-- Shared Modal (only for display section) -->
<div id="qa-shared-modal" class="qa-modal" style="display: none;">
  <div class="qa-modal-content">
    <span class="close-modal">&times;</span>
    <div class="product-qa-form">
      <h3 id="qa-modal-title">Ask a Question</h3>

      <form id="qa-form-modal" class="qa-form">
        <div class="form-group">
          <label for="customer-name-modal" id="name-label-modal">Your Name</label>
          <input type="text" id="customer-name-modal" name="customerName" value="{{ customer.name }}">
        </div>

        <div class="form-group">
          <label for="customer-email-modal" id="email-label-modal">Your Email</label>
          <input type="email" id="customer-email-modal" name="customerEmail" value="{{ customer.email }}">
        </div>

        <div class="form-group">
          <label for="question-modal" id="question-label-modal">Your Question</label>
          <textarea id="question-modal" name="question" rows="4" required></textarea>
        </div>

        <input type="hidden" name="shop" value="{{ shop.domain }}">
        <input type="hidden" name="productId" value="{{ product.id }}">

        <button type="submit" class="btn btn-primary" id="submit-btn-modal">Submit Question</button>
      </form>

      <div id="form-message-modal" class="form-message" style="display: none;"></div>
    </div>
  </div>
</div>

<style>
  .product-qa-wrapper {
    margin: 20px auto;
    {% if block.settings.form_width == 'full_width' %}
      max-width: 100%;
    {% else %}
      max-width: {{ block.settings.form_max_width | default: 600 }}px;
    {% endif %}
  }


  .qa-modal {
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0.5);
    backdrop-filter: blur(3px);
  }

  .qa-modal-content {
    background-color: #ffffff;
    margin: 5% auto;
    padding: 0;
    border-radius: 10px;
    width: 90%;
    max-width: 600px;
    max-height: 80vh;
    overflow-y: auto;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    animation: modalSlideIn 0.3s ease-out;
  }

  @keyframes modalSlideIn {
    from { opacity: 0; transform: translateY(-50px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .close-modal {
    color: #aaa;
    float: right;
    font-size: 28px;
    font-weight: bold;
    padding: 15px 20px 0 0;
    cursor: pointer;
    transition: color 0.3s ease;
  }

  .close-modal:hover,
  .close-modal:focus {
    color: #000;
  }

  .product-qa-form {
    padding: {{ block.settings.form_inner_padding | default: 30 }}px;
    background: {{ block.settings.form_inner_background | default: '#ffffff' }};
    border-radius: {{ block.settings.form_border_radius | default: 8 }}px;
    border: {{ block.settings.form_border_width | default: 1 }}px solid {{ block.settings.form_border_color | default: '#e1e1e1' }};
    {% if block.settings.form_show_shadow %}
      box-shadow: 0 2px 10px {{ block.settings.form_shadow_color | default: 'rgba(0,0,0,0.1)' }};
    {% endif %}
  }

  .product-qa-form h3 {
    margin-top: 0;
    margin-bottom: 20px;
    color: {{ block.settings.title_color | default: '#333333' }};
    font-size: {{ block.settings.title_font_size | default: 24 }}px;
    font-weight: 600;
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
    color: {{ block.settings.text_color | default: '#333333' }};
    font-size: 14px;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 12px 15px;
    border: 1px solid {{ block.settings.input_border_color | default: '#e1e1e1' }};
    border-radius: {{ block.settings.input_border_radius | default: 6 }}px;
    font-size: 16px;
    font-family: inherit;
    transition: all 0.3s ease;
    background-color: #ffffff;
    color: {{ block.settings.text_color | default: '#333333' }};
    box-sizing: border-box;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: {{ block.settings.input_focus_border_color | default: '#007cba' }};
    box-shadow: 0 0 0 3px {{ block.settings.input_focus_border_color | color_modify: 'alpha', 0.1 }};
  }

  .form-group textarea {
    resize: vertical;
    min-height: 100px;
  }

  .btn {
    padding: 12px 24px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-size: 16px;
    font-weight: 600;
    transition: all 0.3s ease;
    text-transform: none;
  }

  .btn-primary {
    background: {{ block.settings.submit_button_bg_color | default: '#007cba' }};
    color: {{ block.settings.submit_button_text_color | default: '#ffffff' }};
    box-shadow: 0 2px 4px rgba(0,123,186,0.3);
  }

  .btn-primary:hover {
    background: {{ block.settings.submit_button_bg_color | default: '#007cba' | color_darken: 10 }};
    transform: translateY(-1px);
    box-shadow: 0 4px 8px rgba(0,123,186,0.4);
  }

  .btn-primary:active {
    transform: translateY(0);
    box-shadow: 0 2px 4px rgba(0,123,186,0.3);
  }

  .form-message {
    margin-top: 20px;
    padding: 15px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 500;
    animation: messageSlideIn 0.3s ease-out;
  }

  @keyframes messageSlideIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .form-message.success {
    background: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }

  .form-message.error {
    background: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }

  /* Loading state */
  .form-loading .btn-primary {
    opacity: 0.7;
    cursor: not-allowed;
    position: relative;
  }

  .form-loading .btn-primary::after {
    content: '';
    position: absolute;
    right: 15px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    border: 2px solid transparent;
    border-top: 2px solid currentColor;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: translateY(-50%) rotate(0deg); }
    100% { transform: translateY(-50%) rotate(360deg); }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .qa-modal-content {
      width: 95%;
      margin: 10% auto;
    }

    .product-qa-form {
      padding: 15px 20px 20px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const productId = document.querySelector('[data-product-id]')?.dataset.productId;
    const sharedModal = document.getElementById('qa-shared-modal');
    const openModalBtn = document.getElementById('open-modal-btn');
    const qaForm = document.getElementById('qa-form');
    const qaFormModal = document.getElementById('qa-form-modal');
    const formMessage = document.getElementById('form-message');
    const formMessageModal = document.getElementById('form-message-modal');

    if (!productId) {
      console.error('Product ID not found');
      return;
    }

    // Global function to open shared modal (can be called from display section)
    window.openQAModal = function() {
      if (sharedModal && window.qaModalSettings) {
        // Update all modal content from display section settings
        const modalTitle = document.getElementById('qa-modal-title');
        const nameLabel = document.getElementById('name-label-modal');
        const nameInput = document.getElementById('customer-name-modal');
        const emailLabel = document.getElementById('email-label-modal');
        const emailInput = document.getElementById('customer-email-modal');
        const questionLabel = document.getElementById('question-label-modal');
        const submitBtn = document.getElementById('submit-btn-modal');

        if (modalTitle) modalTitle.textContent = window.qaModalSettings.title;
        if (nameLabel) nameLabel.textContent = window.qaModalSettings.nameLabel;
        if (nameInput) nameInput.required = window.qaModalSettings.nameRequired;
        if (emailLabel) emailLabel.textContent = window.qaModalSettings.emailLabel;
        if (emailInput) emailInput.required = window.qaModalSettings.emailRequired;
        if (questionLabel) questionLabel.textContent = window.qaModalSettings.questionLabel;
        if (submitBtn) submitBtn.textContent = window.qaModalSettings.submitText;

        sharedModal.style.display = 'block';
        document.body.style.overflow = 'hidden';
      }
    };

    // Global function to close shared modal
    window.closeQAModal = function() {
      if (sharedModal) {
        sharedModal.style.display = 'none';
        document.body.style.overflow = '';
        if (qaFormModal) qaFormModal.reset();
        hideMessage(true); // true for modal
      }
    };

    // Modal close events - needed for display section's ask button
    if (sharedModal) {
      const closeModalBtn = sharedModal.querySelector('.close-modal');

      if (closeModalBtn) {
        closeModalBtn.addEventListener('click', window.closeQAModal);
      }

      sharedModal.addEventListener('click', (e) => {
        if (e.target === sharedModal) {
          window.closeQAModal();
        }
      });
    }

    // Escape key to close modal
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && sharedModal && sharedModal.style.display === 'block') {
        window.closeQAModal();
      }
    });

    // Form submission handler
    function handleFormSubmit(form, isModal = false) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();

        const formData = new FormData(this);
        const submitBtn = this.querySelector('button[type="submit"]');

        // Add loading state
        const originalText = submitBtn.textContent;
        submitBtn.textContent = 'Submitting...';
        submitBtn.disabled = true;
        this.classList.add('form-loading');

        fetch('/apps/a/api/public/questions', {
          method: 'POST',
          body: formData
        })
        .then(response => response.json())
        .then(data => {
          if (data.question || data.success) {
            showMessage('Thank you! Your question has been submitted successfully.', 'success', isModal);
            this.reset();

            // Reload questions if display section exists
            if (window.reloadQuestions) {
              setTimeout(() => window.reloadQuestions(), 1000);
            }

            // Close modal after success if it's the modal form
            if (isModal && sharedModal && sharedModal.style.display === 'block') {
              setTimeout(() => window.closeQAModal(), 2000);
            }
          } else {
            showMessage(data.error || 'Sorry, there was an error submitting your question. Please try again.', 'error', isModal);
          }
        })
        .catch(error => {
          console.error('Error submitting question:', error);
          showMessage('Sorry, there was an error submitting your question. Please try again.', 'error', isModal);
        })
        .finally(() => {
          submitBtn.textContent = originalText;
          submitBtn.disabled = false;
          this.classList.remove('form-loading');
        });
      });
    }

    // Attach form submission handlers
    if (qaForm) {
      handleFormSubmit(qaForm, false);
    }
    if (qaFormModal) {
      handleFormSubmit(qaFormModal, true);
    }

    function showMessage(message, type, isModal = false) {
      const messageElement = isModal ? formMessageModal : formMessage;
      if (messageElement) {
        messageElement.textContent = message;
        messageElement.className = `form-message ${type}`;
        messageElement.style.display = 'block';
      }
    }

    function hideMessage(isModal = false) {
      const messageElement = isModal ? formMessageModal : formMessage;
      if (messageElement) {
        messageElement.style.display = 'none';
        messageElement.className = 'form-message';
      }
    }
  });
</script>

{% schema %}
{
  "name": "Product Q&A Form",
  "target": "section",
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Form Title",
      "default": "Ask a Question"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Title Font Size (px)",
      "min": 14,
      "max": 48,
      "step": 1,
      "default": 24
    },
    {
      "type": "select",
      "id": "form_width",
      "label": "Form Width",
      "options": [
        {"value": "max_width", "label": "Max Width"},
        {"value": "full_width", "label": "Full Width"}
      ],
      "default": "max_width"
    },
    {
      "type": "range",
      "id": "form_max_width",
      "label": "Max Width (px)",
      "min": 300,
      "max": 1000,
      "step": 50,
      "default": 600,
      "info": "Only applies when Form Width is 'Max Width'"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name Field Label",
      "default": "Your Name"
    },
    {
      "type": "checkbox",
      "id": "name_required",
      "label": "Name Required",
      "default": true
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email Field Label",
      "default": "Your Email"
    },
    {
      "type": "checkbox",
      "id": "email_required",
      "label": "Email Required",
      "default": true
    },
    {
      "type": "text",
      "id": "question_label",
      "label": "Question Field Label",
      "default": "Your Question"
    },
    {
      "type": "text",
      "id": "submit_text",
      "label": "Submit Button Text",
      "default": "Submit Question"
    },
    {
      "type": "header",
      "content": "Form Styling"
    },
    {
      "type": "color",
      "id": "form_inner_background",
      "label": "Form Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "form_inner_padding",
      "label": "Form Inner Padding (px)",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 30
    },
    {
      "type": "range",
      "id": "form_border_radius",
      "label": "Form Border Radius (px)",
      "min": 0,
      "max": 25,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "form_border_width",
      "label": "Form Border Width (px)",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 1
    },
    {
      "type": "color",
      "id": "form_border_color",
      "label": "Form Border Color",
      "default": "#e1e1e1"
    },
    {
      "type": "checkbox",
      "id": "form_show_shadow",
      "label": "Show Form Shadow",
      "default": true
    },
    {
      "type": "color",
      "id": "form_shadow_color",
      "label": "Form Shadow Color",
      "default": "rgba(0,0,0,0.1)"
    },
    {
      "type": "header",
      "content": "Submit Button"
    },
    {
      "type": "color",
      "id": "submit_button_bg_color",
      "label": "Submit Button Background",
      "default": "#007cba"
    },
    {
      "type": "color",
      "id": "submit_button_text_color",
      "label": "Submit Button Text Color",
      "default": "#ffffff"
    },
  ]
}
{% endschema %}
