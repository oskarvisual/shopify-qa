{% comment %}
  Product Q&A Form Block
  Form for customers to submit questions
{% endcomment %}

<div class="product-qa-wrapper" data-product-id="{{ product.id }}">
  {% if block.settings.display_style == 'modal' %}
    <!-- Modal Button -->
    <div class="modal-button-container" style="text-align: {{ block.settings.modal_button_alignment }};">
      <button id="open-modal-btn" class="btn btn-modal">{{ block.settings.modal_button_text }}</button>
    </div>

    <!-- Modal Overlay -->
    <div id="qa-modal" class="qa-modal" style="display: none;">
      <div class="qa-modal-content">
        <span class="close-modal">&times;</span>
        <div class="product-qa-form">
          <h3>{{ block.settings.title }}</h3>

          <form id="qa-form" class="qa-form">
            <div class="form-group">
              <label for="customer-name">{{ block.settings.name_label }}</label>
              <input type="text" id="customer-name" name="customerName" value="{{ customer.name }}" {% if block.settings.name_required %}required{% endif %}>
            </div>

            <div class="form-group">
              <label for="customer-email">{{ block.settings.email_label }}</label>
              <input type="email" id="customer-email" name="customerEmail" value="{{ customer.email }}" {% if block.settings.email_required %}required{% endif %}>
            </div>

            <div class="form-group">
              <label for="question">{{ block.settings.question_label }}</label>
              <textarea id="question" name="question" rows="4" required></textarea>
            </div>

            <input type="hidden" name="shop" value="{{ shop.domain }}">

            <button type="submit" class="btn btn-primary">{{ block.settings.submit_text }}</button>
          </form>

          <div id="form-message" class="form-message" style="display: none;"></div>
        </div>
      </div>
    </div>
  {% else %}
    <!-- Always Visible Form -->
    <div class="product-qa-form">
      <h3>{{ block.settings.title }}</h3>

      <form id="qa-form" class="qa-form">
        <div class="form-group">
          <label for="customer-name">{{ block.settings.name_label }}</label>
          <input type="text" id="customer-name" name="customerName" value="{{ customer.name }}" {% if block.settings.name_required %}required{% endif %}>
        </div>

        <div class="form-group">
          <label for="customer-email">{{ block.settings.email_label }}</label>
          <input type="email" id="customer-email" name="customerEmail" value="{{ customer.email }}" {% if block.settings.email_required %}required{% endif %}>
        </div>

        <div class="form-group">
          <label for="question">{{ block.settings.question_label }}</label>
          <textarea id="question" name="question" rows="4" required></textarea>
        </div>

        <input type="hidden" name="shop" value="{{ shop.domain }}">

        <button type="submit" class="btn btn-primary">{{ block.settings.submit_text }}</button>
      </form>

      <div id="form-message" class="form-message" style="display: none;"></div>
    </div>
  {% endif %}
</div>

<style>
  /* Styles remain the same */
</style>

<script>
  // Script remains the same
</script>

{% schema %}
{
  "name": "Product Q&A Form",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Form Title",
      "default": "Ask a Question"
    },
    {
      "type": "select",
      "id": "display_style",
      "label": "Display Style",
      "options": [
        {"value": "visible", "label": "Always Visible"},
        {"value": "modal", "label": "Modal Popup"}
      ],
      "default": "visible"
    },
    {
      "type": "text",
      "id": "modal_button_text",
      "label": "Modal Button Text",
      "default": "Ask a Question"
    },
    {
      "type": "select",
      "id": "modal_button_alignment",
      "label": "Modal Button Alignment",
      "options": [
        {"value": "left", "label": "Left"},
        {"value": "center", "label": "Center"},
        {"value": "right", "label": "Right"}
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name Field Label",
      "default": "Your Name"
    },
    {
      "type": "checkbox",
      "id": "name_required",
      "label": "Name Required",
      "default": true
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email Field Label",
      "default": "Your Email"
    },
    {
      "type": "checkbox",
      "id": "email_required",
      "label": "Email Required",
      "default": true
    },
    {
      "type": "text",
      "id": "question_label",
      "label": "Question Field Label",
      "default": "Your Question"
    },
    {
      "type": "text",
      "id": "submit_text",
      "label": "Submit Button Text",
      "default": "Submit Question"
    }
  ]
}
{% endschema %}