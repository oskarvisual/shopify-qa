{% comment %}
  Product Q&A Form Block
  Form for customers to submit questions
{% endcomment %}

<div class="product-qa-form" data-product-id="{{ product.id }}">
  <h3>{{ block.settings.title }}</h3>
  
  <form id="qa-form" class="qa-form">
    <div class="form-group">
      <label for="customer-name">{{ block.settings.name_label }}</label>
      <input type="text" id="customer-name" name="customerName" {% if block.settings.name_required %}required{% endif %}>
    </div>
    
    <div class="form-group">
      <label for="customer-email">{{ block.settings.email_label }}</label>
      <input type="email" id="customer-email" name="customerEmail" {% if block.settings.email_required %}required{% endif %}>
    </div>
    
    <div class="form-group">
      <label for="question">{{ block.settings.question_label }}</label>
      <textarea id="question" name="question" rows="4" required></textarea>
    </div>
    
    <button type="submit" class="btn btn-primary">{{ block.settings.submit_text }}</button>
  </form>
  
  <div id="form-message" class="form-message" style="display: none;"></div>
</div>

<style>
  .product-qa-form {
    margin: 20px 0;
    padding: 20px;
    border: 1px solid #e1e1e1;
    border-radius: 5px;
    background: #f9f9f9;
  }
  
  .form-group {
    margin-bottom: 15px;
  }
  
  .form-group label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
  }
  
  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 3px;
    font-size: 14px;
  }
  
  .btn {
    padding: 10px 20px;
    border: none;
    border-radius: 3px;
    cursor: pointer;
    font-size: 14px;
  }
  
  .btn-primary {
    background: #007cba;
    color: white;
  }
  
  .btn:hover {
    opacity: 0.9;
  }
  
  .form-message {
    margin-top: 15px;
    padding: 10px;
    border-radius: 3px;
  }
  
  .form-message.success {
    background: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }
  
  .form-message.error {
    background: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('qa-form');
    const productId = document.querySelector('[data-product-id]').dataset.productId;
    const messageDiv = document.getElementById('form-message');
    
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      
      const formData = new FormData(form);
      formData.append('productId', productId);
      
      fetch('/apps/product-questions-and-answers/api/public/questions', {
        method: 'POST',
        body: formData
      })
      .then(response => response.json())
      .then(data => {
        if (data.question) {
          messageDiv.innerHTML = '{{ block.settings.success_message }}';
          messageDiv.className = 'form-message success';
          messageDiv.style.display = 'block';
          form.reset();
        } else {
          throw new Error(data.error || 'Failed to submit question');
        }
      })
      .catch(error => {
        messageDiv.innerHTML = '{{ block.settings.error_message }}';
        messageDiv.className = 'form-message error';
        messageDiv.style.display = 'block';
      });
    });
  });
</script>

{% schema %}
{
  "name": "Product Q&A Form",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Ask a Question"
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name Field Label",
      "default": "Your Name"
    },
    {
      "type": "checkbox",
      "id": "name_required",
      "label": "Name Required",
      "default": false
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email Field Label",
      "default": "Your Email"
    },
    {
      "type": "checkbox",
      "id": "email_required",
      "label": "Email Required",
      "default": false
    },
    {
      "type": "text",
      "id": "question_label",
      "label": "Question Field Label",
      "default": "Your Question"
    },
    {
      "type": "text",
      "id": "submit_text",
      "label": "Submit Button Text",
      "default": "Submit Question"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success Message",
      "default": "Thank you! Your question has been submitted and will be reviewed before being published."
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Error Message",
      "default": "Sorry, there was an error submitting your question. Please try again."
    }
  ]
}
{% endschema %}