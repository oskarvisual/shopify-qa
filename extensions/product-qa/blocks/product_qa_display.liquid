{% comment %}
  Product Q&A Display Block
  Shows existing questions and answers for a product
{% endcomment %}

<div class="product-qa-display" data-product-id="{{ product.id }}">
  <h3>{{ block.settings.title }}</h3>

  {% if block.settings.layout_style == 'inline' and block.settings.show_ask_button %}
    <!-- Inline Layout: Search, Title, Button all in one row -->
    <div class="qa-header qa-header-inline">
      {% if block.settings.show_search %}
        <div class="search-container">
          <input type="text" id="qa-search" class="qa-search-input" placeholder="{{ block.settings.search_placeholder }}">
        </div>
      {% endif %}

      <div class="ask-section-inline">
        <span class="ask-title">{{ block.settings.ask_section_title }}</span>
        <button id="open-ask-modal-btn" class="btn btn-ask">{{ block.settings.ask_button_text }}</button>
      </div>
    </div>
  {% else %}
    <!-- Stacked Layout -->
    {% if block.settings.show_search %}
      <div class="search-container">
        <input type="text" id="qa-search" class="qa-search-input" placeholder="Search questions...">
      </div>
    {% endif %}

    {% if block.settings.show_ask_button %}
      <div class="ask-section-stacked">
        <div class="ask-title">{{ block.settings.ask_section_title }}</div>
        <button id="open-ask-modal-btn" class="btn btn-ask">{{ block.settings.ask_button_text }}</button>
      </div>
    {% endif %}
  {% endif %}

  <!-- Questions List -->
  <div id="qa-list" class="qa-list">
    <div class="loading">Loading questions...</div>
  </div>

  <!-- Load More Button -->
  <div id="load-more-container" class="load-more-container" style="display: none;">
    <button id="load-more-btn" class="btn btn-load-more">{{ block.settings.load_more_text }}</button>
    <div id="loading-more" class="loading-more" style="display: none;">{{ block.settings.loading_more_text }}</div>
  </div>

  {% if block.settings.show_ask_button %}
    <!-- Modal for Ask Question (reusing form code) -->
    <div id="qa-ask-modal" class="qa-modal" style="display: none;">
      <div class="qa-modal-content">
        <span class="close-modal">&times;</span>
        <div class="product-qa-form">
          <h3>{{ block.settings.modal_title }}</h3>

          <form id="qa-ask-form" class="qa-form">
            <div class="form-group">
              <label for="ask-customer-name">{{ block.settings.name_label }}</label>
              <input type="text" id="ask-customer-name" name="customerName" value="{{ customer.name }}">
            </div>

            <div class="form-group">
              <label for="ask-customer-email">{{ block.settings.email_label }}</label>
              <input type="email" id="ask-customer-email" name="customerEmail" value="{{ customer.email }}">
            </div>

            <div class="form-group">
              <label for="ask-question">{{ block.settings.question_field_label }}</label>
              <textarea id="ask-question" name="question" rows="4" required></textarea>
            </div>

            <input type="hidden" name="shop" value="{{ shop.domain }}">

            <button type="submit" class="btn btn-primary">{{ block.settings.submit_button_text }}</button>
          </form>

          <div id="ask-form-message" class="form-message" style="display: none;"></div>
        </div>
      </div>
    </div>
  {% endif %}
</div>

<style>
  .product-qa-display {
    margin: 20px 0;
    padding: 20px;
    background: {{ block.settings.background_color }};
    border-radius: 8px;
  }
  .qa-vote-section {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
  }
  .qa-vote-count {
    font-size: 14px;
    font-weight: 500;
    color: {{ block.settings.meta_text_color }};
  }
  .btn-vote {
    background: {{ block.settings.vote_button_color }};
    color: #fff;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 12px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .btn-vote.voted {
    background: {{ block.settings.voted_button_color }};
    cursor: default;
  }
  .btn-vote .vote-icon {
    width: 14px;
    height: 14px;
  }

  /* Other styles remain the same... */
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // ... (existing script setup)

    // New function to handle voting
    function handleVote(e) {
      e.preventDefault();
      const form = e.target;
      const button = form.querySelector('.btn-vote');
      if (button.classList.contains('voted')) return; // Already voted

      const formData = new FormData(form);
      
      fetch('/apps/a/api/vote', {
        method: 'POST',
        body: formData
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          const voteCountSpan = form.previousElementSibling;
          voteCountSpan.textContent = `${data.votes} votes`;
          button.classList.add('voted');
          button.textContent = 'Voted!';
        } else {
          // Handle error, e.g., show a message that user already voted
          button.textContent = data.error || 'Error';
          button.classList.add('voted'); // Prevent re-trying
        }
      })
      .catch(error => {
        console.error('Error submitting vote:', error);
      });
    }

    // Attach event listeners to vote forms dynamically
    qaList.addEventListener('submit', function(e) {
      if (e.target.classList.contains('qa-vote-form')) {
        handleVote(e);
      }
    });

    // Modified formatQuestion to include vote section
    function formatQuestion(question) {
      const questionMeta = [];
      if (showQuestionAuthor && question.customerName) {
        questionMeta.push(`${textSettings.askedBy} ${question.customerName}`);
      }
      if (showQuestionDate) {
        questionMeta.push(`${textSettings.onDate} ${new Date(question.createdAt).toLocaleDateString()}`);
      }

      const answersHtml = question.answers.map(answer => {
        // ... (answer formatting remains the same)
      }).join('');

      const voteSection = `
        {% if block.settings.show_votes %}
          <div class="qa-vote-section">
            <span class="qa-vote-count">${question.votes} votes</span>
            <form class="qa-vote-form" method="post">
              <input type="hidden" name="questionId" value="${question.id}">
              <input type="hidden" name="shop" value="{{ shop.domain }}">
              <button type="submit" class="btn btn-vote">
                {% if block.settings.show_vote_icon %}
                  <svg class="vote-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333V17a1 1 0 001 1h6.758a1 1 0 00.97-1.222l-1.036-4.143a1 1 0 00-.97-1.222H9.586V7.5a1 1 0 00-2 0v2.833H6zM9 4.5a1.5 1.5 0 113 0v1a1.5 1.5 0 01-3 0v-1z"></path></svg>
                {% endif %}
                <span>{{ block.settings.vote_button_text }}</span>
              </button>
            </form>
          </div>
        {% endif %}
      `;

      return `
        <div class="qa-item">
          <div class="qa-question-container">
            <div class="question-content">
              <span class="question-label">${textSettings.questionLabel}</span>
              <span class="question-text">${question.question}</span>
            </div>
            ${questionMeta.length > 0 ? `<div class="qa-question-meta">${questionMeta.join(' ')}</div>` : ''}
            ${voteSection}
          </div>
          ${answersHtml ? `<div class="qa-answers">${answersHtml}</div>` : ''}
        </div>
      `;
    }

    // ... (rest of the existing script)
  });
</script>

{% schema %}
{
  "name": "Product Q&A Display",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Questions & Answers"
    },
    {
      "type": "header",
      "content": "Voting Settings"
    },
    {
      "type": "checkbox",
      "id": "show_votes",
      "label": "Show Vote Counts & Button",
      "default": true
    },
    {
      "type": "text",
      "id": "vote_button_text",
      "label": "'Helpful' Button Text",
      "default": "Helpful"
    },
    {
      "type": "checkbox",
      "id": "show_vote_icon",
      "label": "Show Thumbs-up Icon",
      "default": true
    },
    {
      "type": "color",
      "id": "vote_button_color",
      "label": "Vote Button Color",
      "default": "#007cba"
    },
    {
      "type": "color",
      "id": "voted_button_color",
      "label": "Voted Button Color",
      "default": "#28a745"
    },
    {
      "type": "header",
      "content": "Display Options"
    }
    // ... (rest of existing settings)
  ]
}
{% endschema %}