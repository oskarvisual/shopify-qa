{% comment %}
  Product Q&A Display Block
  Shows existing questions and answers for a product
{% endcomment %}

<div class="product-qa-display" data-product-id="{{ product.id }}">
  <h3>{{ block.settings.title }}</h3>
  
  <div id="qa-list" class="qa-list">
    <div class="loading">Loading questions...</div>
  </div>
  
  {% if block.settings.show_ask_button %}
    <button id="ask-question-btn" class="btn btn-primary">
      {{ block.settings.ask_button_text }}
    </button>
  {% endif %}
</div>

<style>
  .product-qa-display {
    margin: 20px 0;
    padding: 20px;
    border: 1px solid #e1e1e1;
    border-radius: 5px;
  }
  
  .qa-item {
    margin-bottom: 20px;
    padding: 15px;
    background: #f9f9f9;
    border-radius: 5px;
  }
  
  .question {
    font-weight: bold;
    margin-bottom: 10px;
  }
  
  .answer {
    margin-left: 20px;
    padding: 10px;
    background: white;
    border-radius: 3px;
    border-left: 3px solid #007cba;
  }
  
  .qa-meta {
    font-size: 12px;
    color: #666;
    margin-top: 5px;
  }
  
  .loading {
    text-align: center;
    padding: 20px;
    color: #666;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const productId = document.querySelector('[data-product-id]').dataset.productId;
    const qaList = document.getElementById('qa-list');
    
    // Fetch questions for this product
    fetch(`/apps/product-questions-and-answers/api/public/questions?productId=${productId}`)
      .then(response => response.json())
      .then(data => {
        if (data.questions && data.questions.length > 0) {
          qaList.innerHTML = data.questions.map(question => `
            <div class="qa-item">
              <div class="question">${question.question}</div>
              <div class="qa-meta">Asked by ${question.customerName || 'Anonymous'} on ${new Date(question.createdAt).toLocaleDateString()}</div>
              ${question.answers.map(answer => `
                <div class="answer">
                  <div>${answer.answer}</div>
                  <div class="qa-meta">Answered by ${answer.authorName} on ${new Date(answer.createdAt).toLocaleDateString()}</div>
                </div>
              `).join('')}
            </div>
          `).join('');
        } else {
          qaList.innerHTML = '<div class="no-questions">No questions yet. Be the first to ask!</div>';
        }
      })
      .catch(error => {
        console.error('Error loading questions:', error);
        qaList.innerHTML = '<div class="error">Failed to load questions.</div>';
      });
  });
</script>

{% schema %}
{
  "name": "Product Q&A Display",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Questions & Answers"
    },
    {
      "type": "checkbox",
      "id": "show_ask_button",
      "label": "Show Ask Question Button",
      "default": true
    },
    {
      "type": "text",
      "id": "ask_button_text",
      "label": "Ask Button Text",
      "default": "Ask a Question"
    }
  ]
}
{% endschema %}