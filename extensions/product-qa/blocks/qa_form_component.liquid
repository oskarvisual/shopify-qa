{% comment %}
  Guard to ensure this component is only rendered once per page.
  This prevents duplicating modals, styles, and scripts if multiple blocks
  on the same page try to render it.
{% endcomment %}
{%- if __qa_form_component_rendered__ -%}
  {% comment %} Component has already been rendered. Do nothing. {% endcomment %}
{%- else -%}
  {%- assign __qa_form_component_rendered__ = true -%}

{% comment %}
  Q&A Ask Question Form Block v24
  - Handles both an inline form and a shared modal form.
  - Implements AI-first workflow for customer questions.
  - Two-button AI voting system (Helpful/Not Helpful)
  - Simplified thumbs down icon using CSS rotation
  - Vote button text now from block.settings (no JS needed)
  - Fixed modal opening to work with fallback modal
  Cache: v24-2025-11-06
{% endcomment %}
<!-- QA Form v24 - Fixed modal opening with fallback support - 2025-11-06 -->

<div class="product-qa-wrapper" data-product-id="{{ product.id }}">
  <!-- Always Visible INLINE Form -->
  <div class="product-qa-form">
    <h3>{{ block.settings.title }}</h3>
    <form id="qa-form" class="qa-form" onsubmit="return false;">
      <div id="qa-ai-response-container" style="display: none;">
        <p><strong id="qa-suggested-answer-label">Suggested Answer:</strong></p>
        <div id="qa-ai-answer"></div>
        <div class="qa-vote-container" data-version="20251028-v21">
          <button type="button" class="btn-vote btn-vote-helpful" data-vote="1" data-button-type="helpful">
            <svg class="vote-icon" width="16" height="16" viewBox="0 0 20 20" fill="currentColor">
              <path d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333V17a1 1 0 001 1h6.758a1 1 0 00.97-1.222l-1.036-4.143a1 1 0 00-.97-1.222H9.586V7.5a1 1 0 00-2 0v2.833H6z"></path>
            </svg>
            <span class="vote-label">{{ block.settings.ai_helpful_button_text | default: 'Helpful' }}</span>
          </button>
          <button type="button" class="btn-vote btn-vote-not-helpful" data-vote="-1" data-button-type="not-helpful">
            <svg class="vote-icon vote-icon-down" width="16" height="16" viewBox="0 0 20 20" fill="currentColor">
              <path d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333V17a1 1 0 001 1h6.758a1 1 0 00.97-1.222l-1.036-4.143a1 1 0 00-.97-1.222H9.586V7.5a1 1 0 00-2 0v2.833H6z"></path>
            </svg>
            <span class="vote-label">{{ block.settings.ai_not_helpful_button_text | default: 'Not Helpful' }}</span>
          </button>
        </div>
        <div class="qa-ai-options">
          <p id="qa-human-prompt"></p>
          <button type="button" id="qa-ask-human-btn" class="btn btn-secondary"></button>
        </div>
      </div>
      <div id="qa-question-container">
        <div class="form-group">
          <label for="question">{{ block.settings.question_label | default: 'Your Question' }}</label>
          <textarea id="question" name="question" rows="4" required maxlength="500"></textarea>
          <div class="char-counter">0 / 500</div>
        </div>
      </div>
      <div id="qa-human-form-fields" style="display: none;">
        <div class="form-group">
          <label for="customer-name">{{ block.settings.name_label | default: 'Your Name' }}</label>
          <input type="text" id="customer-name" name="customerName" value="{{ customer.name }}" {% if block.settings.name_required %}required{% endif %}>
        </div>
        <div class="form-group">
          <label for="customer-email">{{ block.settings.email_label | default: 'Your Email' }}</label>
          <input type="email" id="customer-email" name="customerEmail" value="{{ customer.email }}" {% if block.settings.email_required %}required{% endif %}>
        </div>
      </div>
      <input type="hidden" name="shop" value="{{ shop.domain }}">
      <input type="hidden" name="productId" value="{{ product.id }}">
      <div class="qa-form-actions">
        <button type="submit" id="qa-submit-btn" class="btn btn-primary btn-full-width" data-default-text="{{ block.settings.submit_text | default: 'Submit Question' }}"></button>
        <button type="button" id="qa-ask-ai-btn" class="btn btn-primary btn-full-width" style="display: none;" data-default-text="Ask with AI"></button>
        <button type="button" id="qa-bypass-ai-btn" class="btn-link-style" style="display: none;"></button>
      </div>
    </form>
    <div id="form-message" class="form-message" style="display: none;"></div>
  </div>
</div>

<!-- SHARED MODAL structure -->
<div id="qa-shared-modal" class="qa-modal" style="display: none;">
  <div class="qa-modal-content">
    <span class="close-modal">&times;</span>
    <div class="product-qa-form">
      <h3 id="qa-modal-title">{{ block.settings.ask_modal_title | default: "Ask a Question" }}</h3>
      <form id="qa-form-modal" class="qa-form" onsubmit="return false;">
        <div id="qa-ai-response-container-modal" style="display: none;">
          <p><strong id="qa-suggested-answer-label-modal">Suggested Answer:</strong></p>
          <div id="qa-ai-answer-modal"></div>
          <div class="qa-vote-container-modal" data-version="20251028-v21">
            <button type="button" class="btn-vote btn-vote-helpful" data-vote="1" data-button-type="helpful">
              <svg class="vote-icon" width="16" height="16" viewBox="0 0 20 20" fill="currentColor">
                <path d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333V17a1 1 0 001 1h6.758a1 1 0 00.97-1.222l-1.036-4.143a1 1 0 00-.97-1.222H9.586V7.5a1 1 0 00-2 0v2.833H6z"></path>
              </svg>
              <span class="vote-label">{{ block.settings.ai_helpful_button_text | default: 'Helpful' }}</span>
            </button>
            <button type="button" class="btn-vote btn-vote-not-helpful" data-vote="-1" data-button-type="not-helpful">
              <svg class="vote-icon vote-icon-down" width="16" height="16" viewBox="0 0 20 20" fill="currentColor">
                <path d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333V17a1 1 0 001 1h6.758a1 1 0 00.97-1.222l-1.036-4.143a1 1 0 00-.97-1.222H9.586V7.5a1 1 0 00-2 0v2.833H6z"></path>
              </svg>
              <span class="vote-label">{{ block.settings.ai_not_helpful_button_text | default: 'Not Helpful' }}</span>
            </button>
          </div>
          <div class="qa-ai-options">
            <p id="qa-human-prompt-modal"></p>
            <button type="button" id="qa-ask-human-btn-modal" class="btn btn-secondary"></button>
          </div>
        </div>
        <div id="qa-question-container-modal">
          <div class="form-group">
            <label for="question-modal">{{ block.settings.modal_question_label | default: 'Your Question' }}</label>
            <textarea id="question-modal" name="question" rows="4" required maxlength="500"></textarea>
            <div class="char-counter-modal">0 / 500</div>
          </div>
        </div>
        <div id="qa-human-form-fields-modal" style="display: none;">
          <div class="form-group">
            <label for="customer-name-modal">{{ block.settings.modal_name_label | default: 'Your Name' }}</label>
            <input type="text" id="customer-name-modal" name="customerName" value="{{ customer.name }}" {% if block.settings.modal_name_required %}required{% endif %}>
          </div>
          <div class="form-group">
            <label for="customer-email-modal">{{ block.settings.modal_email_label | default: 'Your Email' }}</label>
            <input type="email" id="customer-email-modal" name="customerEmail" value="{{ customer.email }}" {% if block.settings.modal_email_required %}required{% endif %}>
          </div>
        </div>
        <input type="hidden" name="shop" value="{{ shop.domain }}">
        <input type="hidden" name="productId" value="{{ product.id }}">
        <div class="qa-form-actions">
            <button type="submit" id="qa-submit-btn-modal" class="btn btn-primary btn-full-width" data-default-text="{{ block.settings.modal_submit_text | default: 'Submit Question' }}"></button>
            <button type="button" id="qa-ask-ai-btn-modal" class="btn btn-primary btn-full-width" style="display: none;" data-default-text="Ask with AI"></button>
            <button type="button" id="qa-bypass-ai-btn-modal" class="btn-link-style" style="display: none;"></button>
        </div>
      </form>
      <div id="form-message-modal" class="form-message" style="display: none;"></div>
    </div>
  </div>
</div>

<style>
  .product-qa-wrapper { margin: 20px auto; max-width: {{ block.settings.form_max_width | default: 600 }}px; }
  .char-counter, .char-counter-modal { text-align: right; font-size: 12px; color: #6B7280; margin-top: 4px; }
  .product-qa-form { padding: {{ block.settings.form_inner_padding | default: 30 }}px; background: #fff; border-radius: 8px; border: 1px solid #e1e1e1; }
  .product-qa-form h3 { margin-top: 0; margin-bottom: 20px; font-size: 22px; }
  .qa-modal .product-qa-form { border: none; background: transparent; box-shadow: none; }
  .form-group { margin-bottom: 20px; }
  .form-group label { display: block; margin-bottom: 8px; font-weight: 600; }
  .form-group input, .form-group textarea { width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 6px; font-size: 16px; box-sizing: border-box; }
  .form-group textarea { resize: vertical; min-height: 100px; }
  .btn { padding: 12px 24px; border: none; border-radius: 6px; cursor: pointer; font-size: 16px; font-weight: 600; transition: all 0.3s ease; }
  .btn.btn-full-width { width: 100%; }
  .btn-primary { background: {{ block.settings.submit_button_bg_color | default: '#007cba' }}; color: #fff; }
  .btn-secondary { background: #f0f0f0; color: #333; }
  .btn-link-style { background: none; border: none; color: #6B7280; text-decoration: underline; cursor: pointer; padding: 10px; font-size: 14px; width: 100%; text-align: center; }
  .qa-form-actions { display: flex; flex-direction: column; gap: 10px; }
  .form-message { margin-top: 20px; padding: 15px; border-radius: 6px; }
  .form-message.success { background: #d4edda; color: #155724; }
  .form-message.error { background: #f8d7da; color: #721c24; }
  .btn[disabled] { opacity: 0.7; cursor: not-allowed; }
  #qa-ai-response-container, #qa-ai-response-container-modal { padding: 15px; border: 1px solid #e1e1e1; border-radius: 6px; margin-bottom: 20px; background: #f9f9f9; }
  #qa-ai-answer, #qa-ai-answer-modal { margin-bottom: 15px; white-space: pre-wrap; }
  .qa-vote-container, .qa-vote-container-modal { display: flex; justify-content: center; gap: 10px; margin-bottom: 15px; position: relative; }
  .product-qa-form .btn-vote { padding: 8px 16px; min-width: 120px; text-align: center; border: 1px solid var(--p-border, #d0d0d0); background: var(--p-surface, #f6f6f7); border-radius: 4px; cursor: pointer; font-size: 14px; transition: all 0.2s ease; display: inline-flex; align-items: center; justify-content: center; gap: 6px; }
  .product-qa-form .btn-vote:hover:not([disabled]) { background: var(--p-surface-subdued, #e4e5e7); transform: translateY(-1px); }
  .product-qa-form .btn-vote .vote-icon { width: 16px; height: 16px; flex-shrink: 0; }
  .product-qa-form .btn-vote-not-helpful .vote-icon { transform: rotate(180deg); }
  .product-qa-form .btn-vote-helpful { background: #e8f5e9; border-color: #4caf50; color: #2e7d32; }
  .product-qa-form .btn-vote-helpful:hover:not([disabled]) { background: #c8e6c9; }
  .product-qa-form .btn-vote-helpful.voted { background: #4caf50; border-color: #388e3c; color: white; cursor: default; }
  .product-qa-form .btn-vote-not-helpful { background: #ffebee; border-color: #f44336; color: #c62828; }
  .product-qa-form .btn-vote-not-helpful:hover:not([disabled]) { background: #ffcdd2; }
  .product-qa-form .btn-vote-not-helpful.voted { background: #f44336; border-color: #d32f2f; color: white; cursor: default; }
  .product-qa-form .btn-vote:disabled { opacity: 0.6; cursor: default; transform: none; }
  .qa-ai-options { margin-top: 15px; border-top: 1px solid #e1e1e1; padding-top: 15px; text-align: center; }
  .qa-ai-options p { margin: 0 0 10px; font-size: 14px; }
  .qa-modal { display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); }
  .qa-modal-content { background-color: #fefefe; margin: 10% auto; padding: 20px; border: 1px solid #888; width: 80%; max-width: 600px; border-radius: 8px; }
  .close-modal { color: #aaa; float: right; font-size: 28px; font-weight: bold; cursor: pointer; }
</style>

<script data-qa-form-version="v24-20251106-modal-fix">
document.addEventListener('DOMContentLoaded', function() {
    console.log('[QA Form] Script loading, version v24-20251106');

    const productId = document.querySelector('.product-qa-wrapper')?.dataset.productId;
    const shopDomain = '{{ shop.domain }}';

    console.log('[QA Form] Elements check:', {
      productId,
      sharedModal: !!document.getElementById('qa-shared-modal')
    });

    if (!productId) {
      console.warn('[QA Form] No product ID found, form block may not be on this page');
      return;
    }

    const sharedModal = document.getElementById('qa-shared-modal');
    let texts = {
        success: 'Thank you! Your question has been submitted.',
        error: 'There was an error.',
        submitting: 'Submitting...',
        aiSubmitButton: 'Ask with AI',
        aiHumanPrompt: 'Not the answer you were looking for?',
        aiHumanButton: 'Ask a Human Expert',
        aiBypassButton: 'Or, ask a human',
        aiSuggestedAnswerLabel: 'Suggested Answer:',
        aiHelpfulButton: 'Helpful',
        aiHelpfulVoted: 'Voted!',
        aiNotHelpfulButton: 'Not Helpful',
        aiNotHelpfulVoted: 'Voted!'
    };

    // Only define openQAModal if it doesn't exist yet
    if (!window.openQAModal) {
      window.openQAModal = function() {
        const mainModal = document.getElementById('qa-shared-modal');
        const fallbackModal = document.getElementById('qa-fallback-modal');

        console.log('[QA Form] openQAModal called:', { mainModal: !!mainModal, fallbackModal: !!fallbackModal });

        if (mainModal) {
          console.log('[QA Form] Opening main modal');
          mainModal.style.display = 'block';
        } else if (fallbackModal) {
          console.log('[QA Form] Opening fallback modal');
          fallbackModal.style.display = 'block';
        } else {
          console.error('[QA Form] No modal found! Check if both blocks are loaded correctly.');
        }
      };
    } else {
      console.log('[QA Form] openQAModal already defined, skipping definition');
    }

    window.closeQAModal = function() {
      const mainModal = document.getElementById('qa-shared-modal');
      const fallbackModal = document.getElementById('qa-fallback-modal');
      if (mainModal) mainModal.style.display = 'none';
      if (fallbackModal) fallbackModal.style.display = 'none';
    };
    if (sharedModal) {
      sharedModal.querySelector('.close-modal')?.addEventListener('click', window.closeQAModal);
      sharedModal.addEventListener('click', (e) => { if (e.target === sharedModal) window.closeQAModal(); });
    }
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && sharedModal?.style.display === 'block') window.closeQAModal(); });

    function setupForm(formId) {
      const formElement = document.getElementById(formId);
      if (!formElement) return null;

      const isModal = formId.includes('modal');
      const prefix = isModal ? '-modal' : '';
      let currentAiLogId = null;
      let humanMode = false;

      const elements = {
        questionContainer: document.getElementById('qa-question-container' + prefix),
        humanFormFields: document.getElementById('qa-human-form-fields' + prefix),
        aiResponseContainer: document.getElementById('qa-ai-response-container' + prefix),
        aiAnswerDiv: document.getElementById('qa-ai-answer' + prefix),
        suggestedAnswerLabel: document.getElementById('qa-suggested-answer-label' + prefix),
        voteContainer: formElement.querySelector('.qa-vote-container' + prefix),
        submitBtn: document.getElementById('qa-submit-btn' + prefix),
        askAiBtn: document.getElementById('qa-ask-ai-btn' + prefix),
        askHumanBtn: document.getElementById('qa-ask-human-btn' + prefix),
        bypassAiBtn: document.getElementById('qa-bypass-ai-btn' + prefix),
        questionTextarea: document.getElementById('question' + prefix),
        formMessage: document.getElementById('form-message' + prefix),
        charCounter: formElement.querySelector('.char-counter' + prefix),
        humanPrompt: document.getElementById('qa-human-prompt' + prefix),
        customerNameInput: formElement.querySelector('input[name="customerName"]'),
        customerEmailInput: formElement.querySelector('input[name="customerEmail"]')
      };

      if (!elements.questionTextarea) return null;

      if (elements.charCounter) {
        elements.questionTextarea.addEventListener('input', () => {
          elements.charCounter.textContent = `${elements.questionTextarea.value.length} / 500`;
        });
      }

      async function updateAiLog(data) {
        if (!currentAiLogId) return;
        try {
          await fetch('/apps/a/api/public/ai-log-update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ aiLogId: currentAiLogId, ...data })
          });
        } catch (error) {
          console.error('Failed to update AI log:', error);
        }
      }

      function showHumanForm() {
        if (currentAiLogId) {
            updateAiLog({ askedHuman: true });
        }
        elements.aiResponseContainer.style.display = 'none';
        elements.questionContainer.style.display = 'block';
        elements.humanFormFields.style.display = 'block';
        elements.askAiBtn.style.display = 'none';
        elements.bypassAiBtn.style.display = 'none';
        elements.submitBtn.style.display = 'inline-block';
        humanMode = true;
        resetVoteButtons();
      }

      function setInitialState(aiEnabled) {
        if (aiEnabled) {
          elements.askAiBtn.style.display = 'inline-block';
          elements.bypassAiBtn.style.display = 'inline-block';
          elements.submitBtn.style.display = 'none';
          elements.humanFormFields.style.display = 'none';
          humanMode = false;
        } else {
          humanMode = true;
          showHumanForm();
        }
      }

      elements.askHumanBtn.addEventListener('click', showHumanForm);
      elements.bypassAiBtn.addEventListener('click', showHumanForm);

      function resetVoteButtons() {
        if (!elements.voteContainer) return;
        const buttons = elements.voteContainer.querySelectorAll('.btn-vote');
        console.log('[QA Form] resetVoteButtons() called, found', buttons.length, 'buttons');
        buttons.forEach((button, index) => {
          button.disabled = false;
          button.classList.remove('voted');
          const isHelpful = button.classList.contains('btn-vote-helpful');
          const defaultLabel = button.dataset.defaultText || (isHelpful ? texts.aiHelpfulButton : texts.aiNotHelpfulButton);
          const labelSpan = button.querySelector('.vote-label');
          console.log(`[QA Form] Button ${index}:`, {
            isHelpful,
            datasetDefaultText: button.dataset.defaultText,
            textsValue: isHelpful ? texts.aiHelpfulButton : texts.aiNotHelpfulButton,
            finalLabel: defaultLabel
          });
          if (labelSpan) {
            labelSpan.textContent = defaultLabel;
          }
        });
      }

      if (elements.voteContainer) {
        elements.voteContainer.addEventListener('click', (e) => {
          const button = e.target.closest('.btn-vote');
          if (!button || button.disabled) {
            return;
          }
          const voteValue = parseInt(button.dataset.vote);
          const isHelpful = voteValue === 1;

          // Disable both buttons
          const allButtons = elements.voteContainer.querySelectorAll('.btn-vote');
          allButtons.forEach(btn => btn.disabled = true);

          // Mark this button as voted
          button.classList.add('voted');
          const labelSpan = button.querySelector('.vote-label');
          if (labelSpan) {
            labelSpan.textContent = isHelpful ? texts.aiHelpfulVoted : texts.aiNotHelpfulVoted;
          }

          // Send vote to backend
          updateAiLog({ vote: voteValue });
        });
        // Don't reset here - wait for translations to load first
      }

      elements.askAiBtn.addEventListener('click', async () => {
        const question = elements.questionTextarea.value.trim();
        if (!question) {
          showMessage('Please enter a question first.', 'error');
          return;
        }

        elements.askAiBtn.disabled = true;
        elements.askAiBtn.textContent = texts.submitting;
        elements.bypassAiBtn.style.display = 'none';
        hideMessage();

        try {
          const response = await fetch('/apps/a/api/public/ai-answer', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ customerQuestion: question, productId, shop: shopDomain })
          });

          if (!response.ok) throw new Error('Network response was not ok');
          const data = await response.json();
          currentAiLogId = data.aiLogId;

          if (data.error || !data.answer || !data.message) {
            const fallbackMessage = data.error || data.message || 'No immediate answer available. Please ask a human expert.';
            showMessage(fallbackMessage, 'error');
            showHumanForm();
          } else {
            elements.aiAnswerDiv.textContent = data.message;
            elements.aiResponseContainer.style.display = 'block';
            elements.questionContainer.style.display = 'none';
            elements.askAiBtn.style.display = 'none';
            elements.submitBtn.style.display = 'none';
            resetVoteButtons();
          }
        } catch (error) {
          console.error('AI Answer fetch error:', error);
          showMessage('Error contacting AI. Please ask a human expert.', 'error');
          showHumanForm();
        } finally {
          elements.askAiBtn.disabled = false;
          elements.askAiBtn.textContent = elements.askAiBtn.dataset.defaultText;
        }
      });

      elements.submitBtn.addEventListener('click', function(e) {
        e.preventDefault();

        const trimmedQuestion = elements.questionTextarea.value.trim();
        if (!trimmedQuestion) {
          showMessage('Please enter a question.', 'error');
          elements.questionTextarea.focus();
          return;
        }
        elements.questionTextarea.value = trimmedQuestion;

        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

        if (humanMode) {
          if (elements.customerNameInput) {
            const nameValue = elements.customerNameInput.value.trim();
            if (!nameValue) {
              showMessage('Please enter your name.', 'error');
              elements.customerNameInput.focus();
              return;
            }
            elements.customerNameInput.value = nameValue;
          }

          if (elements.customerEmailInput) {
            const emailValue = elements.customerEmailInput.value.trim();
            if (!emailValue) {
              showMessage('Please enter your email.', 'error');
              elements.customerEmailInput.focus();
              return;
            }
            if (!emailRegex.test(emailValue)) {
              showMessage('Please enter a valid email address.', 'error');
              elements.customerEmailInput.focus();
              return;
            }
            elements.customerEmailInput.value = emailValue;
          }
        }

        const formData = new FormData(formElement);
        elements.submitBtn.disabled = true;
        elements.submitBtn.textContent = texts.submitting;

        fetch('/apps/a/api/public/questions', { method: 'POST', body: formData })
          .then(res => res.json())
          .then(data => {
            if (data.question || data.success) {
              showMessage(texts.success, 'success');
              formElement.reset();
              if (window.reloadQuestions) setTimeout(() => window.reloadQuestions(), 1000);
              if (isModal) setTimeout(window.closeQAModal, 2000);
            } else {
              showMessage(data.error || texts.error, 'error');
            }
          })
          .catch(err => showMessage(texts.error, 'error'))
          .finally(() => {
            elements.submitBtn.disabled = false;
            elements.submitBtn.textContent = elements.submitBtn.dataset.defaultText;
          });
      });
      
      function showMessage(message, type) {
        if (!elements.formMessage) return;
        elements.formMessage.textContent = message;
        elements.formMessage.className = `form-message ${type}`;
        elements.formMessage.style.display = 'block';
      }

      function hideMessage() {
        if (!elements.formMessage) return;
        elements.formMessage.style.display = 'none';
      }

      function applyTranslations(translations) {
        texts = {
            ...texts,
            ...(translations.formSuccessMessage && { success: translations.formSuccessMessage }),
            ...(translations.formErrorMessage && { error: translations.formErrorMessage }),
            ...(translations.formSubmittingText && { submitting: translations.formSubmittingText }),
            ...(translations.aiSubmitButton && { aiSubmitButton: translations.aiSubmitButton }),
            ...(translations.aiHumanPrompt && { aiHumanPrompt: translations.aiHumanPrompt }),
            ...(translations.aiHumanButton && { aiHumanButton: translations.aiHumanButton }),
            ...(translations.aiBypassButton && { aiBypassButton: translations.aiBypassButton }),
            ...(translations.aiSuggestedAnswerLabel && { aiSuggestedAnswerLabel: translations.aiSuggestedAnswerLabel }),
            ...(translations.aiHelpfulButton && { aiHelpfulButton: translations.aiHelpfulButton }),
            ...(!translations.aiHelpfulButton && translations.displayHelpfulText ? { aiHelpfulButton: translations.displayHelpfulText } : {}),
            ...(translations.displayVotedText && { aiHelpfulVoted: translations.displayVotedText }),
            ...(translations.aiNotHelpfulButton && { aiNotHelpfulButton: translations.aiNotHelpfulButton }),
            ...(translations.displayVotedText && { aiNotHelpfulVoted: translations.displayVotedText }),
        };

        if (elements.submitBtn) {
            elements.submitBtn.textContent = elements.submitBtn.dataset.defaultText;
        }
        if (elements.suggestedAnswerLabel) {
            elements.suggestedAnswerLabel.textContent = texts.aiSuggestedAnswerLabel;
        }
        if (elements.askAiBtn) {
            elements.askAiBtn.textContent = texts.aiSubmitButton;
            elements.askAiBtn.dataset.defaultText = texts.aiSubmitButton;
        }
        if(elements.humanPrompt) elements.humanPrompt.textContent = texts.aiHumanPrompt;
        if(elements.askHumanBtn) elements.askHumanBtn.textContent = texts.aiHumanButton;
        if(elements.bypassAiBtn) elements.bypassAiBtn.textContent = texts.aiBypassButton;

        // Only update vote buttons if custom translations are provided
        if (elements.voteContainer && (translations.aiHelpfulButton || translations.aiNotHelpfulButton)) {
          const helpfulButton = elements.voteContainer.querySelector('.btn-vote-helpful');
          const notHelpfulButton = elements.voteContainer.querySelector('.btn-vote-not-helpful');

          if (helpfulButton && translations.aiHelpfulButton) {
            helpfulButton.dataset.defaultText = texts.aiHelpfulButton;
            const labelSpan = helpfulButton.querySelector('.vote-label');
            if (labelSpan) {
              labelSpan.textContent = texts.aiHelpfulButton;
            }
          }
          if (notHelpfulButton && translations.aiNotHelpfulButton) {
            notHelpfulButton.dataset.defaultText = texts.aiNotHelpfulButton;
            const labelSpan = notHelpfulButton.querySelector('.vote-label');
            if (labelSpan) {
              labelSpan.textContent = texts.aiNotHelpfulButton;
            }
          }
        }
        // Don't call resetVoteButtons() here - we just set the labels above
      }

      return { setInitialState, applyTranslations };
    }

    const inlineForm = setupForm('qa-form');
    const modalForm = setupForm('qa-form-modal');

    Promise.all([
      fetch(`/apps/a/api/public/ai-settings?shop=${encodeURIComponent(shopDomain)}`).then(res => res.ok ? res.json() : { aiEnabled: false }),
      fetch(`/apps/a/api/public/translations?shop=${encodeURIComponent(shopDomain)}`).then(res => res.ok ? res.json() : { translations: {} })
    ]).then(([aiSettings, translationData]) => {
      const translations = translationData.translations || {};

      console.log('[QA Form] Loaded translations:', translations);
      console.log('[QA Form] AI Settings:', aiSettings);

      if (inlineForm) {
        inlineForm.applyTranslations(translations);
        inlineForm.setInitialState(aiSettings.aiEnabled);
      }
      if (modalForm) {
        modalForm.applyTranslations(translations);
        modalForm.setInitialState(aiSettings.aiEnabled);
      }
    }).catch(error => {
      console.error("Error fetching settings or translations:", error);
      if (inlineForm) inlineForm.setInitialState(false);
      if (modalForm) modalForm.setInitialState(false);
    });
});
</script>

