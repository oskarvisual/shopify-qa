// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model Question {
  id               String    @id @default(cuid())
  shop             String
  productId        String
  productType      String?
  productCategory  String?
  productTags      String?
  customerName     String?
  customerEmail    String?
  question         String    @db.Text
  isPublished      Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  votes            Int       @default(0)
  originalImportId String?

  answers    Answer[]
  voteLogs   VoteLog[]

  @@index([shop, productId])
  @@unique([shop, originalImportId], name: "shop_original_import_id")
}

model Answer {
  id          String   @id @default(cuid())
  shop        String
  questionId  String
  authorName  String
  authorEmail String?
  answer      String   @db.Text
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade, map: "Answer_questionId_fkey")

  @@index([shop, questionId])
  @@index([questionId])
}

model VoteLog {
  id         String   @id @default(cuid())
  questionId String
  shop       String
  identifier String
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, identifier, shop])
  @@index([questionId])
}

model WebhookSetting {
  id              String    @id @default(cuid())
  shop            String    @unique
  url             String?
  newQuestion     Boolean   @default(false)
  editQuestion    Boolean   @default(false)
  deleteQuestion  Boolean   @default(false)
  newAnswer       Boolean   @default(false)
  editAnswer      Boolean   @default(false)
  deleteAnswer    Boolean   @default(false)
  approveQuestion Boolean   @default(false)
  newVote         Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model EmailSetting {
  id                   String    @id @default(cuid())
  shop                 String    @unique
  notificationsEnabled Boolean   @default(false)
  notifyOnNewQuestion  Boolean   @default(false)
  autoApproveQuestions Boolean @default(false)
  notificationEmails   String?   @db.Text
  smtpProvider         String    @default("APP")
  smtpHost             String?
  smtpPort             Int?
  smtpUser             String?
  smtpPass             String?
  smtpSecure           Boolean   @default(true)

  answerEmailSubject          String? @db.Text
  answerEmailBody             String? @db.Text
  questionPublishedSubject    String? @db.Text
  questionPublishedEmailBody  String? @db.Text
  newQuestionAdminSubject     String? @db.Text
  newQuestionAdminEmailBody   String? @db.Text

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Config {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model EmailLog {
  id        String   @id @default(cuid())
  shop      String
  to        String
  subject   String   @db.Text
  body      String   @db.LongText
  smtpHost  String?
  smtpPort  Int?
  smtpUser  String?
  status    String
  response  String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop])
}

model AiSetting {
  id              String    @id @default(cuid())
  shop            String    @unique
  aiEnabled       Boolean   @default(false)
  aiLanguage      String    @default("English")
  aiInstructions  String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AiLog {
  id               String    @id @default(cuid())
  shop             String
  productId        String
  customerQuestion String    @db.Text
  aiAnswer         String?   @db.Text
  vote             Int?
  askedHuman       Boolean   @default(false)
  noAnswer         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  feedback         AiFeedback[]

  @@index([shop, productId])
}

model AiFeedback {
  id           String    @id @default(cuid())
  aiLogId      String
  adminUserId  String
  adminUserName String?
  rating       Int
  feedbackText String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  aiLog AiLog @relation(fields: [aiLogId], references: [id], onDelete: Cascade)

  @@unique([aiLogId, adminUserId])
  @@index([aiLogId])
}
