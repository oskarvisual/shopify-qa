// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model Question {
  id               String    @id @default(cuid())
  shop             String
  productId        String
  productType      String?   // Technical product type (e.g., "snowboard")
  productCategory  String?   // Main collection/category (e.g., "Hydrogen")
  productTags      String?   // Comma-separated tags (e.g., "Accessory, Sport, Winter")
  customerName     String?
  customerEmail    String?
  question         String    @db.Text
  isPublished      Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  votes            Int       @default(0)
  originalImportId String?   // To map answers to questions during import

  answers    Answer[]
  voteLogs   VoteLog[]

  @@index([shop, productId])
  @@unique([shop, originalImportId], name: "shop_original_import_id")
}

model Answer {
  id          String   @id @default(cuid())
  shop        String
  questionId  String
  authorName  String
  authorEmail String?
  answer      String   @db.Text
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([shop, questionId])
  @@index([questionId])
}

model VoteLog {
  id         String   @id @default(cuid())
  questionId String
  shop       String
  identifier String // Will store IP address or customer ID/email
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, identifier, shop])
  @@index([questionId])
}

model WebhookSetting {
  id              String    @id @default(cuid())
  shop            String    @unique
  url             String?
  newQuestion     Boolean   @default(false)
  editQuestion    Boolean   @default(false)
  deleteQuestion  Boolean   @default(false)
  newAnswer       Boolean   @default(false)
  editAnswer      Boolean   @default(false)
  deleteAnswer    Boolean   @default(false)
  approveQuestion Boolean   @default(false)
  newVote         Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model EmailSetting {
  id                   String    @id @default(cuid())
  shop                 String    @unique
  notificationsEnabled Boolean   @default(false)
  notifyOnNewQuestion  Boolean   @default(false)
  autoApproveQuestions Boolean @default(false)
  notificationEmails   String?   @db.Text
  smtpProvider         String    @default("APP") // "APP" or "CUSTOM"
  smtpHost             String?
  smtpPort             Int?
  smtpUser             String?
  // TODO: This should be encrypted at rest
  smtpPass             String?
  smtpSecure           Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Config {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model EmailLog {
  id        String   @id @default(cuid())
  shop      String
  to        String
  subject   String   @db.Text
  body      String   @db.LongText
  smtpHost  String?
  smtpPort  Int?
  smtpUser  String?
  status    String   // e.g., "SENT", "FAILED"
  response  String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop])
}
